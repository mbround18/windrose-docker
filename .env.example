# Example .env file for Windrose Docker

# --- General Configuration ---
# Name of the server
NAME="Windrose Dedicated Server"
# Steam AppID for the Windrose dedicated server
APP_ID=4129620
# Path to install the server files
INSTALL_PATH=/home/steam/windrose
# Force Windows version installation/execution
FORCE_WINDOWS=true
# Launch mode (e.g., native, wine, proton)
LAUNCH_MODE=proton
# Proton version to use (e.g., GE-Proton10-34)
PROTON_VERSION=GE-Proton10-34
# Executable path relative to INSTALL_PATH
EXECUTABLE=/home/steam/windrose/R5/Binaries/Win64/WindroseServer-Win64-Shipping.exe
# Launch arguments for the server
WINDROSE_LAUNCH_ARGS=--log

# --- Server Settings (mapped to JSON) ---
# The name of the server displayed in the server list
WINDROSE_SERVER_NAME="My Awesome Windrose Server"
# Maximum number of players
WINDROSE_MAX_PLAYERS=16
# Server region
WINDROSE_REGION="US"
# Enable direct connection
WINDROSE_DIRECT_CONNECTION=true
# Port for direct connection
WINDROSE_DIRECT_PORT=7777

# --- Monitoring & Auto-Update ---
# Enable automatic updates (true or false)
AUTO_UPDATE=true
# Cron schedule for automatic updates
AUTO_UPDATE_CRON="0 3 * * *"
